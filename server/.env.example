# ─── Serveur SMTP ────────────────────────────────────────────────────────────
# Exemples de configurations SMTP courantes (décommentez selon votre hébergeur)

# OVH / Infomaniak / hébergeur classique
SMTP_HOST=mail.votre-hebergeur.fr
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@equinoxe-evasion.fr
SMTP_PASS=votre_mot_de_passe

# Gmail (nécessite un "Mot de passe d'application" : myaccount.google.com > Sécurité)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre.adresse@gmail.com
# SMTP_PASS=xxxx_xxxx_xxxx_xxxx   ← mot de passe d'application (16 caractères)

# ─── Email de destination ─────────────────────────────────────────────────────
# L'adresse qui recevra les messages du formulaire
MAIL_TO=contact@equinoxe-evasion.fr

# L'expéditeur affiché (doit correspondre à SMTP_USER chez la plupart des hébergeurs)
MAIL_FROM=contact@equinoxe-evasion.fr
MAIL_FROM_NAME=Équinoxe Évasion

# ─── reCAPTCHA v3 ────────────────────────────────────────────────────────────
# Créez vos clés sur https://www.google.com/recaptcha/admin/create
# Choisissez "reCAPTCHA v3" et ajoutez votre domaine
# La clé de site va dans le composant Angular (RECAPTCHA_SITE_KEY dans contact.component.ts)
# La clé secrète reste ici, côté serveur uniquement
RECAPTCHA_SECRET_KEY=votre_cle_secrete_recaptcha

# Score minimum pour accepter l'envoi (0.0 = bot certain, 1.0 = humain certain)
# La valeur recommandée est 0.5
RECAPTCHA_MIN_SCORE=0.5

# ─── Serveur ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
